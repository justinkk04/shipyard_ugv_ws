<?xml version="1.0"?>
<sdf version="1.8">
  <world name="shipyard_corridor_u">

    <!-- Core Gazebo systems -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Needed for GPU LiDAR / LaserScan sensors -->
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Needed for IMU sensors -->
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <!-- Large indoor facility floor under the U-shaped corridor -->
    <model name="facility_floor">
      <static>true</static>
      <pose>0 0 -0.01 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.0 12.0 0.02</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.0 12.0 0.02</size></box></geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- U-shaped corridor floor strips: bottom leg, turn/vertical leg, top leg -->
    <model name="bottom_corridor_floor">
      <static>true</static>
      <pose>0 -3.0 0.005 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.0 3.2 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.0 3.2 0.03</size></box></geometry>
          <material><ambient>0.38 0.38 0.38 1</ambient><diffuse>0.38 0.38 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="right_turn_corridor_floor">
      <static>true</static>
      <pose>5.0 0.0 0.006 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>3.2 9.2 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>3.2 9.2 0.03</size></box></geometry>
          <material><ambient>0.40 0.40 0.40 1</ambient><diffuse>0.40 0.40 0.40 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="top_corridor_floor">
      <static>true</static>
      <pose>0 3.0 0.007 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>12.0 3.2 0.03</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>12.0 3.2 0.03</size></box></geometry>
          <material><ambient>0.38 0.38 0.38 1</ambient><diffuse>0.38 0.38 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Corridor walls. Width is about 3.2 m so LiDAR avoidance has room to work. -->
    <model name="bottom_outer_wall">
      <static>true</static><pose>0 -4.65 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>12.2 0.12 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12.2 0.12 1.0</size></box></geometry><material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual></link>
    </model>

    <model name="bottom_inner_wall">
      <static>true</static><pose>-1.3 -1.35 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>9.4 0.12 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>9.4 0.12 1.0</size></box></geometry><material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual></link>
    </model>

    <model name="right_outer_wall">
      <static>true</static><pose>6.65 0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.12 9.4 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.12 9.4 1.0</size></box></geometry><material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual></link>
    </model>

    <model name="right_inner_wall">
      <static>true</static><pose>3.35 0 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.12 2.7 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.12 2.7 1.0</size></box></geometry><material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual></link>
    </model>

    <model name="top_inner_wall">
      <static>true</static><pose>-1.3 1.35 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>9.4 0.12 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>9.4 0.12 1.0</size></box></geometry><material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual></link>
    </model>

    <model name="top_outer_wall">
      <static>true</static><pose>0 4.65 0.5 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>12.2 0.12 1.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12.2 0.12 1.0</size></box></geometry><material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material></visual></link>
    </model>

    <!-- Indoor overhead beams and light panels, visual only -->
    <model name="overhead_beam_bottom"><static>true</static><pose>0 -3.0 1.35 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>12.0 0.08 0.08</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual></link></model>
    <model name="overhead_beam_vertical"><static>true</static><pose>5.0 0.0 1.35 0 0 1.5708</pose><link name="link"><visual name="visual"><geometry><box><size>9.0 0.08 0.08</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual></link></model>
    <model name="overhead_beam_top"><static>true</static><pose>0 3.0 1.35 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>12.0 0.08 0.08</size></box></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual></link></model>

    <model name="light_panel_1"><static>true</static><pose>-2.5 -3.0 1.32 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.1 0.25 0.04</size></box></geometry><material><ambient>1.0 0.95 0.65 1</ambient><diffuse>1.0 0.95 0.65 1</diffuse></material></visual></link></model>
    <model name="light_panel_2"><static>true</static><pose>5.0 0.0 1.32 0 0 1.5708</pose><link name="link"><visual name="visual"><geometry><box><size>1.1 0.25 0.04</size></box></geometry><material><ambient>1.0 0.95 0.65 1</ambient><diffuse>1.0 0.95 0.65 1</diffuse></material></visual></link></model>
    <model name="light_panel_3"><static>true</static><pose>0.5 3.0 1.32 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>1.1 0.25 0.04</size></box></geometry><material><ambient>1.0 0.95 0.65 1</ambient><diffuse>1.0 0.95 0.65 1</diffuse></material></visual></link></model>

    <!-- Start and endpoint markers -->
    <model name="start_zone_marker">
      <static>true</static><pose>-5.0 -3.0 0.025 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>0.9 0.9 0.02</size></box></geometry><material><ambient>0.0 0.25 1.0 0.65</ambient><diffuse>0.0 0.25 1.0 0.65</diffuse></material></visual></link>
    </model>

    <model name="inspection_endpoint_marker">
      <static>true</static><pose>-5.0 3.0 0.025 0 0 0</pose>
      <link name="link"><visual name="visual"><geometry><box><size>1.0 1.0 0.02</size></box></geometry><material><ambient>0.0 1.0 0.25 0.75</ambient><diffuse>0.0 1.0 0.25 0.75</diffuse></material></visual></link>
    </model>

    <!-- Small yellow waypoint markers along the predefined route -->
    <model name="wp_1"><static>true</static><pose>-2.0 -3.0 0.035 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.20 0.20 0.03</size></box></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual></link></model>
    <model name="wp_2"><static>true</static><pose>2.0 -3.0 0.035 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.20 0.20 0.03</size></box></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual></link></model>
    <model name="wp_3_turn"><static>true</static><pose>5.0 -3.0 0.035 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.20 0.20 0.03</size></box></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual></link></model>
    <model name="wp_4"><static>true</static><pose>5.0 0.0 0.035 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.20 0.20 0.03</size></box></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual></link></model>
    <model name="wp_5_turn"><static>true</static><pose>5.0 3.0 0.035 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.20 0.20 0.03</size></box></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual></link></model>
    <model name="wp_6"><static>true</static><pose>1.5 3.0 0.035 0 0 0</pose><link name="link"><visual name="visual"><geometry><box><size>0.20 0.20 0.03</size></box></geometry><material><ambient>1 0.9 0 1</ambient><diffuse>1 0.9 0 1</diffuse></material></visual></link></model>

    <!-- Avoidable obstacles / shipyard maintenance clutter -->
    <model name="avoidable_obstruction_red_block">
      <static>true</static><pose>0.0 -3.0 0.35 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.65 0.65 0.70</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.65 0.65 0.70</size></box></geometry><material><ambient>1 0.05 0.05 1</ambient><diffuse>1 0.05 0.05 1</diffuse></material></visual></link>
    </model>

    <model name="left_side_crate_bottom">
      <static>true</static><pose>1.8 -2.0 0.25 0 0 0.25</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.55 0.40 0.50</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.55 0.40 0.50</size></box></geometry><material><ambient>0.55 0.32 0.12 1</ambient><diffuse>0.55 0.32 0.12 1</diffuse></material></visual></link>
    </model>

    <model name="maintenance_cart_vertical">
      <static>true</static><pose>5.8 0.8 0.25 0 0 1.5708</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.75 0.45 0.50</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.75 0.45 0.50</size></box></geometry><material><ambient>0.08 0.12 0.35 1</ambient><diffuse>0.08 0.12 0.35 1</diffuse></material></visual></link>
    </model>

    <model name="right_side_crate_top">
      <static>true</static><pose>1.5 3.9 0.25 0 0 -0.35</pose>
      <link name="link"><collision name="collision"><geometry><box><size>0.70 0.40 0.50</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.70 0.40 0.50</size></box></geometry><material><ambient>0.55 0.32 0.12 1</ambient><diffuse>0.55 0.32 0.12 1</diffuse></material></visual></link>
    </model>

    <model name="maintenance_cone_top">
      <static>true</static><pose>4.1 3.7 0.30 0 0 0</pose>
      <link name="link"><collision name="collision"><geometry><cylinder><radius>0.18</radius><length>0.60</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.18</radius><length>0.60</length></cylinder></geometry><material><ambient>1.0 0.70 0.0 1</ambient><diffuse>1.0 0.70 0.0 1</diffuse></material></visual></link>
    </model>

  </world>
</sdf>
