<?xml version="1.0"?>
<sdf version="1.8">
  <world name="shipyard_corridor_clear_world">

    <!-- Core Gazebo / Ignition systems -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Required for simulated 2D LiDAR / LaserScan -->
    <plugin filename="libignition-gazebo-sensors-system.so" name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <!-- Required for simulated IMU -->
    <plugin filename="libignition-gazebo-imu-system.so" name="ignition::gazebo::systems::Imu"/>

    <!-- Indoor-like lighting. Kept simple so the world is easy to view in Gazebo. -->
    <light type="directional" name="overhead_ambient_light">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>-0.2 0.1 -0.95</direction>
    </light>

    <!-- ============================================================ -->
    <!-- Mission geometry: simplified indoor shipyard maintenance corridor -->
    <!-- Coordinate convention: robot starts near x=-4.0 and drives toward +x. -->
    <!-- Blue = start zone, green = inspection endpoint. -->
    <!-- ============================================================ -->

    <model name="corridor_floor">
      <static>true</static>
      <pose>2.0 0 0.0 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>19.0 3.6 0.02</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>19.0 3.6 0.02</size></box></geometry>
          <material><ambient>0.42 0.42 0.42 1</ambient><diffuse>0.42 0.42 0.42 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="left_corridor_wall">
      <static>true</static>
      <pose>2.0 1.75 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>19.0 0.12 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>19.0 0.12 1.2</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="right_corridor_wall">
      <static>true</static>
      <pose>2.0 -1.75 0.6 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>19.0 0.12 1.2</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>19.0 0.12 1.2</size></box></geometry>
          <material><ambient>0.62 0.62 0.62 1</ambient><diffuse>0.62 0.62 0.62 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="start_threshold_line">
      <static>true</static>
      <pose>-5.0 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 3.2 0.03</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="endpoint_threshold_line">
      <static>true</static>
      <pose>8.8 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.08 3.2 0.03</size></box></geometry>
          <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="start_zone_marker">
      <static>true</static>
      <pose>-4.0 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.0 1.3 0.02</size></box></geometry>
          <material><ambient>0.1 0.25 0.95 1</ambient><diffuse>0.1 0.25 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="endpoint_marker">
      <static>true</static>
      <pose>8.0 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>1.2 1.3 0.02</size></box></geometry>
          <material><ambient>0.1 0.85 0.2 1</ambient><diffuse>0.1 0.85 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
    
   <model name="start_zone_waypoint_marker">
      <static>true</static>
      <pose>-4.0 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.025</size></box></geometry>
          <material><ambient>1.0 0.9 0.05 1</ambient><diffuse>1.0 0.9 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    
    <model name="centerline_waypoint_marker_1">
      <static>true</static>
      <pose>-1.0 0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.025</size></box></geometry>
          <material><ambient>1.0 0.9 0.05 1</ambient><diffuse>1.0 0.9 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="centerline_waypoint_marker_2">
      <static>true</static>
      <pose>2.0 0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.025</size></box></geometry>
          <material><ambient>1.0 0.9 0.05 1</ambient><diffuse>1.0 0.9 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="centerline_waypoint_marker_3">
      <static>true</static>
      <pose>5.0 0 0.03 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.025</size></box></geometry>
          <material><ambient>1.0 0.9 0.05 1</ambient><diffuse>1.0 0.9 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="endpoint_zone_waypoint_marker">
      <static>true</static>
      <pose>8.0 0 0.025 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><box><size>0.18 0.18 0.025</size></box></geometry>
          <material><ambient>1.0 0.9 0.05 1</ambient><diffuse>1.0 0.9 0.05 1</diffuse></material>
        </visual>
      </link>
    </model>
    
  </world>
</sdf>
