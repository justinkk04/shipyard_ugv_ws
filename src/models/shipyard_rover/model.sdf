<sdf version='1.9'>
  <model name='my_robot'>
    <link name='base_footprint'>
      <inertial>
        <pose>0.003773584905660379 0 0.2018867924528302 0 0 0</pose>
        <mass>5.2999999999999998</mass>
        <inertia>
          <ixx>0.089328132075471661</ixx>
          <ixy>0</ixy>
          <ixz>0.0030377358490566051</ixz>
          <iyy>0.17659266037735841</iyy>
          <iyz>0</iyz>
          <izz>0.2216945283018868</izz>
        </inertia>
      </inertial>
      <collision name='base_footprint_fixed_joint_lump__base_link_collision'>
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.4 0.2</size>
          </box>
        </geometry>
      </collision>
      <collision name='base_footprint_fixed_joint_lump__castor_wheel_link_collision_1'>
        <pose>0.2 0 0.05 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.050000000000000003</radius>
          </sphere>
        </geometry>
        <surface>
          <contact>
            <ode/>
          </contact>
          <friction>
            <ode>
              <mu>0.01</mu>
              <mu2>0.01</mu2>
            </ode>
          </friction>
        </surface>
      </collision>
      <visual name='base_footprint_fixed_joint_lump__base_link_visual'>
        <pose>0 0 0.2 0 0 0</pose>
        <geometry>
          <box>
            <size>0.6 0.4 0.2</size>
          </box>
        </geometry>
        <material>
          <diffuse>0 1 0 1</diffuse>
          <ambient>0 1 0 1</ambient>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__castor_wheel_link_visual_1'>
        <pose>0.2 0 0.05 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.050000000000000003</radius>
          </sphere>
        </geometry>
        <material>
          <diffuse>0.875 0.875 0.875 1</diffuse>
          <ambient>0.875 0.875 0.875 1</ambient>
        </material>
      </visual>
      <visual name='base_footprint_fixed_joint_lump__lidar_link_visual_2'>
        <pose>0 0 0.325 0 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>1 1 1 1</diffuse>
          <ambient>1 1 1 1</ambient>
        </material>
      </visual>
      <sensor name='gpu_lidar' type='gpu_lidar'>
        <pose relative_to='lidar_link'>0 0 0 0 0 0</pose>

        <topic>/scan</topic>
        <frame_id>lidar_link</frame_id>

        <update_rate>10</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>

        <ray>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>

          <range>
            <min>0.10</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
        </ray>
      </sensor>
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0.25 0 0 0</pose>
        <topic>/imu</topic>
        <frame_id>base_link</frame_id>
        <update_rate>50</update_rate>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>
    </link>
    <joint name='base_left_wheel_joint' type='revolute'>
      <pose relative_to='base_footprint'>-0.15 0.225 0.1 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>left_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='left_wheel_link'>
      <pose relative_to='base_left_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.20000000000000001</mass>
        <inertia>
          <ixx>0.00054199999999999995</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.00054199999999999995</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_link_collision'>
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='left_wheel_link_visual'>
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.875 0.875 0.875 1</diffuse>
          <ambient>0.875 0.875 0.875 1</ambient>
        </material>
      </visual>
    </link>
    <joint name='base_right_wheel_joint' type='revolute'>
      <pose relative_to='base_footprint'>-0.15 -0.225 0.1 0 0 0</pose>
      <parent>base_footprint</parent>
      <child>right_wheel_link</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-10000000000000000</lower>
          <upper>10000000000000000</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='right_wheel_link'>
      <pose relative_to='base_right_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.20000000000000001</mass>
        <inertia>
          <ixx>0.00054199999999999995</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.001</iyy>
          <iyz>0</iyz>
          <izz>0.00054199999999999995</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_link_collision'>
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='right_wheel_link_visual'>
        <pose>0 0 0 1.57 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
        <material>
          <diffuse>0.875 0.875 0.875 1</diffuse>
          <ambient>0.875 0.875 0.875 1</ambient>
        </material>
      </visual>
    </link>
    <frame name='base_castor_wheel_joint' attached_to='base_link'>
      <pose>0.2 0 -0.05 0 -0 0</pose>
    </frame>
    <frame name='castor_wheel_link' attached_to='base_castor_wheel_joint'/>
    <frame name='base_lidar_joint' attached_to='base_link'>
      <pose>0 0 0.225 0 -0 0</pose>
    </frame>
    <frame name='lidar_link' attached_to='base_lidar_joint'/>
    <frame name='base_footprint_joint' attached_to='base_footprint'>
      <pose>0 0 0.1 0 -0 0</pose>
    </frame>
    <frame name='base_link' attached_to='base_footprint_joint'/>
    <plugin
      filename="libignition-gazebo-diff-drive-system.so"
      name="ignition::gazebo::systems::DiffDrive">

      <left_joint>base_left_wheel_joint</left_joint>
      <right_joint>base_right_wheel_joint</right_joint>

      <wheel_separation>0.45</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <topic>/cmd_vel</topic>
      <odom_topic>/odom</odom_topic>
      <odom_publish_frequency>20</odom_publish_frequency>
    </plugin>
  </model>
</sdf>
